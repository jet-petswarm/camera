--------------------------------------------------------------------------
local SUF = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24, oc = 1e27, no = 1e30, dc = 1e33 }
local FMT = { {1e33,"dc"},{1e30,"no"},{1e27,"oc"},{1e24,"sp"},{1e21,"sx"},{1e18,"qi"},{1e15,"qa"},{1e12,"t"},{1e9,"b"},{1e6,"m"},{1e3,"k"} }

local function parseNum(v)
	if type(v) == "number" then return v end
	if type(v) ~= "string" then return nil end
	local s = (v:lower():gsub("[%$,]", ""))
	local n, suf = s:match("^[^%d%.]*(%d+%.?%d*)%s*(%a*)%s*$")
	n = tonumber(n)
	if not n then return nil end
	if suf and suf ~= "" and SUF[suf] then n = n * SUF[suf] end
	return n
end

local function fmt(n)
	if not n then return "--" end
	for _, f in ipairs(FMT) do
		if math.abs(n) >= f[1] then return string.format("%.2f%s", n / f[1], f[2]) end
	end
	return string.format("%.0f", n)
end

