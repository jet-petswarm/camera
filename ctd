-- เล่น
--------------------------------------------------------------------------
local function waitReady(alive)
	while alive() and not (TowerAdd and TowerUpgrade and TowerSell) do
		phase = "match"
		task.wait(0.5)
	end
	phase = "act"
	return alive()
end

local function waitMoney(step, price, alive)
	if step.type == "sell" or price <= 0 then return true end
	local t0 = os.clock()
	while alive() do
		local m = getMoney()
		if m == nil then
			if CFG.useDelay and step.delay then task.wait(math.min(step.delay, 30)) end
			phase = "act"
			return true
		end
		if m >= price then
			phase = "act"
			return true
		end
		phase = "money"
		if CFG.moneyTimeout > 0 and os.clock() - t0 > CFG.moneyTimeout then return false end
		task.wait(0.15)
	end
	return "stop"
end

local function attemptAdd(step, alive, vt)
	local id = unitIdFor(step)
	if not id then return false, 0, "unit not in slots: " .. tostring(step.name) end
	local pos = Vector3.new(unpack(step.pos))
	local cf = CFrame.new(unpack(step.cframe))
	if (nearCount(pos, 2) or 0) >= 1 then return true, 0, "already placed" end
	local base = nearCount(pos, 3) or 0
	local before = getMoney()
	TowerAdd:FireServer({ UnitId = id, CFrame = cf, Name = step.name, Pos = pos })
	local t, drop = os.clock(), 0
	while alive() and os.clock() - t < vt do
		task.wait(0.05)
		local m = getMoney()
		if before and m then drop = math.max(drop, before - m) end
		local n = nearCount(pos, 3)
		if n and n > base then
			task.wait(0.25)
			local m2 = getMoney()
			if before and m2 then drop = math.max(drop, before - m2) end
			return true, drop
		end
		if n == nil and drop > 0 then return true, drop end
		if n == nil and before == nil and os.clock() - t > 0.6 then return true, 0 end
	end
	return false, drop, "not placed"
end

local function attemptTarget(step, price, alive, vt)
	if not step.tpos then return false, 0, "no position" end
	local id, inst = findNearestTower(Vector3.new(unpack(step.tpos)), 10)
	if not id then return false, 0, "tower not found at position" end
	local before = getMoney()
	local t, drop = os.clock(), 0
	if step.type == "upgrade" then
		TowerUpgrade:FireServer({ Id = id })
		while alive() and os.clock() - t < vt do
			task.wait(0.05)
			local m = getMoney()
			if before and m then drop = math.max(drop, before - m) end
			local e = upEvt[id]
			if e and e.t >= t then
				task.wait(0.2)
				local m2 = getMoney()
				if before and m2 then drop = math.max(drop, before - m2) end
				return true, drop
			end
			if price > 0 and drop >= price * 0.9 then return true, drop end
		end
		return false, drop, "upgrade not confirmed"
	else
		TowerSell:FireServer({ Id = id })
		while alive() and os.clock() - t < vt do
			task.wait(0.05)
			if not inst.Parent or not inst:IsDescendantOf(workspace) then return true, 0 end
		end
		return false, 0, "not sold"
	end
end

local function execStep(step, alive, idx)
	local retry = math.max(1, tonumber(CFG.retry) or 3)
	local vt = tonumber(CFG.verifyTimeout) or 3
	if not waitReady(alive) then return false end
	for attempt = 1, retry do
		if not alive() then return false end
		local price = priceOf(idx)
		local g = waitMoney(step, price, alive)
		if g == "stop" then return false end
		if g == false then
			warn("[JetHub Camera] step " .. tostring(idx) .. " money wait timed out")
			return false
		end
		local ok, drop, why
		if step.type == "add" then ok, drop, why = attemptAdd(step, alive, vt)
		else ok, drop, why = attemptTarget(step, price, alive, vt) end
		if ok then
			if drop and drop > 0 and CFG.autoLearn then
				setLearned(idx, drop)
				autoSave()
				UI.refresh()
			end
			return true
		end
		warn(string.format("[JetHub Camera] step %s attempt %d: %s", tostring(idx), attempt, tostring(why)))
		task.wait(0.4)
	end
	return false
end

local function stopMacro()
	running = false
	runId = runId + 1
	phase = "act"
end

local function runMacro(startIdx)
	if running or recording then return false end
	if #steps == 0 then status("no_steps") return false end
	recompute()
	running = true
	runId = runId + 1
	local my = runId
	local function alive() return running and my == runId end
	task.spawn(function()
		repeat
			for i = startIdx or 1, #steps do
				if not alive() then break end
				curIdx = i
				local ok = execStep(steps[i], alive, i)
				if not ok and alive() then status("step_skipped", i) end
			end
			startIdx = 1
			if not alive() then break end
			curIdx = #steps + 1
			if flags.loop then
				-- รอแมตช์ใหม่ (ตัวละครในแมพถูกล้างจนเหลือ 0) แล้วเริ่มใหม่
				phase = "loop"
				local seen, t0 = false, os.clock()
				while alive() do
					local f = towersFolder()
					local n = f and #f:GetChildren() or 0
					if n > 0 then seen = true end
					if (seen or os.clock() - t0 > 5) and n == 0 then break end
					if not f and os.clock() - t0 > 10 then break end
					task.wait(0.5)
				end
				phase = "act"
				if alive() then curIdx = 0 end
			end
		until not (alive() and flags.loop)
		if my == runId and running then
			running = false
			phase = "act"
			flags.play = false
			saveCfg()
			UI.playOff()
			status("play_done")
		end
	end)
	return true
end

