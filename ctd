local function showTab(i, animate)
	for j, t in ipairs(tabs) do
		t.btn.TextColor3 = (j == i) and C.text or C.sub
		if j ~= i then t.page.Visible = false end
	end
	local cur = tabs[i]
	cur.page.Visible = true
	local y = TAB_Y0 + (i - 1) * (TAB_H + 4)
	if animate then
		cur.page.GroupTransparency = 1
		cur.page.Position = UDim2.fromOffset(0, 14)
		tw(cur.page, 0.3, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, QUINT)
		tw(JH.indicator, 0.3, { Position = UDim2.fromOffset(7, y) }, QUINT)
	else
		cur.page.GroupTransparency = 0
		cur.page.Position = UDim2.fromOffset(0, 0)
		JH.indicator.Position = UDim2.fromOffset(7, y)
	end
	CFG.tab = i
end

local function newPage(key)
	local idx = #tabs + 1
	local page = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, content)
	local b = new("TextButton", {
		Size = UDim2.new(1, -14, 0, TAB_H), Position = UDim2.fromOffset(7, TAB_Y0 + (idx - 1) * (TAB_H + 4)),
		BackgroundTransparency = 1, Text = "", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.sub,
		Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false, BorderSizePixel = 0,
	}, side)
	new("UIPadding", { PaddingLeft = UDim.new(0, 16) }, b)
	bind(b, "Text", key)
	tabs[idx] = { page = page, btn = b }
	b.MouseEnter:Connect(function() if CFG.tab ~= idx then tw(b, 0.12, { TextColor3 = C.text }) end end)
	b.MouseLeave:Connect(function() if CFG.tab ~= idx then tw(b, 0.15, { TextColor3 = C.sub }) end end)
	b.MouseButton1Click:Connect(function()
		if CFG.tab ~= idx then showTab(idx, true) saveCfg() end
	end)
	return page
end

