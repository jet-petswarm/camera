local UUID = ("%x"):rep(8) .. "%-" .. ("%x"):rep(4) .. "%-" .. ("%x"):rep(4) .. "%-" .. ("%x"):rep(4) .. "%-" .. ("%x"):rep(12)
local function isUUID(s) return type(s) == "string" and s:match("^" .. UUID .. "$") ~= nil end

local function idOf(inst)
	if isUUID(inst.Name) then return inst.Name end
	for _, v in pairs(inst:GetAttributes()) do
		if isUUID(v) then return v end
	end
	for _, c in ipairs(inst:GetChildren()) do
		if c:IsA("ValueBase") and isUUID(c.Value) then return c.Value end
	end
	return nil
end

local function posOf(inst)
	if inst:IsA("Model") then
		local ok, cf = pcall(inst.GetPivot, inst)
		if ok then return cf.Position end
	elseif inst:IsA("BasePart") then
		return inst.Position
	end
	local p = inst:FindFirstChildWhichIsA("BasePart", true)
	return p and p.Position
end

local function towersFolder()
	local g = workspace:FindFirstChild("Game")
	return g and g:FindFirstChild("Towers")
end

local function nearCount(pos, r)
	local f = towersFolder()
	if not f then return nil end
	local c = 0
	for _, t in ipairs(f:GetChildren()) do
		local p = posOf(t)
		if p and (p - pos).Magnitude <= r then c = c + 1 end
	end
	return c
end

local function findTowerById(id)
	local f = towersFolder()
	local pool = f and f:GetChildren() or workspace:GetDescendants()
	for _, t in ipairs(pool) do
		if idOf(t) == id then return t end
	end
	if f then
		for _, t in ipairs(f:GetDescendants()) do
			if idOf(t) == id then return t end
		end
	end
	return nil
end

local function findNearestTower(pos, maxDist)
	local f = towersFolder()
	local pool = f and f:GetChildren() or workspace:GetDescendants()
	local best, bestD, bestId = nil, maxDist, nil
	for _, t in ipairs(pool) do
		local id = idOf(t)
		if id then
			local p = posOf(t)
			if p then
				local d = (p - pos).Magnitude
				if d <= bestD then best, bestD, bestId = t, d, id end
			end
		end
	end
	return bestId, best
end

local function unitIdFor(step)
	for i = 1, 5 do
		local n = LP:GetAttribute("Slot" .. i)
		local id = LP:GetAttribute("Slot" .. i .. "Id")
		if n == step.name and type(id) == "string" and id ~= "" then return id end
	end
	return step.unitId
end

