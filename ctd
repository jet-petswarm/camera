-- ลูปฟีเจอร์ Game
local last = {}
local function due(k, iv)
	local n = os.clock()
	iv = math.max(0.2, tonumber(iv) or 1)
	if not last[k] or n - last[k] >= iv then
		last[k] = n
		return true
	end
	return false
end
task.spawn(function()
	while gui.Parent do
		if flags.vote and due("vote", CFG.voteInterval) then fireEvent("ModeVote", CFG.voteMode) end
		if flags.speed and due("speed", CFG.speedInterval) then invokeFunc("ChangeSpeed", CFG.speed) end
		if flags.skip and due("skip", CFG.skipInterval) then fireEvent("WaveSkip") end
		if flags.again and due("again", CFG.againInterval) then fireEvent("PlayAgain") end
		task.wait(0.2)
	end
end)

