}

local function new(cls, props, parent)
	local o = Instance.new(cls)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o, r) new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function apply(o, props) for k, v in pairs(props or {}) do o[k] = v end return o end

local function txt(parent, t, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Text = t, TextColor3 = C.text, Font = Enum.Font.GothamMedium,
		TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
	return apply(l, props)
end
local function btn(parent, t, props, cb)
	local b = new("TextButton", {
		Text = t, BackgroundColor3 = C.sel, TextColor3 = C.text, Font = Enum.Font.GothamBold,
		TextSize = 12, AutoButtonColor = true, BorderSizePixel = 0,
	}, parent)
	corner(b, 6)
	apply(b, props)
	if cb then b.MouseButton1Click:Connect(cb) end
