local function unitList()
	local seen, out = {}, {}
	for i, s in ipairs(steps) do
		local m = meta[i]
		if s.type == "add" and m and not seen[m.unit] then
			seen[m.unit] = true
			out[#out + 1] = m.unit
		end
	end
	return out
end

