local function onRecord(remote, a)
	if not recording then return end
	local now = os.clock()
	local delay = now - lastT
	lastT = now
	local before = getMoney()
	local step
	if remote == TowerAdd then
		if typeof(a.CFrame) ~= "CFrame" or type(a.Name) ~= "string" then return end
		local cf = a.CFrame
		local p = (typeof(a.Pos) == "Vector3") and a.Pos or cf.Position
		step = { type = "add", name = a.Name, unitId = a.UnitId, cframe = { cf:GetComponents() }, pos = { p.X, p.Y, p.Z }, delay = delay }
	elseif remote == TowerUpgrade or remote == TowerSell then
		if not a.Id then return end
		local inst = findTowerById(a.Id)
		local p = inst and posOf(inst)
		if not p then status("tower_pos_missing") return end
		step = { type = (remote == TowerUpgrade) and "upgrade" or "sell", tpos = { p.X, p.Y, p.Z }, delay = delay }
	else
		return
	end
	table.insert(steps, step)
	recompute()
	local idx = #steps
	local m = meta[idx]
	UI.refresh()
	status("rec_progress", #steps)
	if before and step.type ~= "sell" and m then
		task.spawn(function()
			local d = measureDrop(before, 3)
			if d > 0 then
				local p = pslot(m.unit, m.stage, true)
				if not (CFG.priceLockAll or p.locked) then p.price = d end
				UI.refresh()
			end
		end)
	end
end

