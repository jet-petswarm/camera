local vpModel, vpT = nil, 0
local function armPose(clone, side, p)
	local sgn = (side == "Right") and 1 or -1
	local up = clone:FindFirstChild(side .. "UpperArm")
	local lo = clone:FindFirstChild(side .. "LowerArm")
	local hd = clone:FindFirstChild(side .. "Hand")
	if not (up and lo and hd) then return false end
	local sh = up:FindFirstChild(side .. "Shoulder")
	local el = lo:FindFirstChild(side .. "Elbow")
	local wr = hd:FindFirstChild(side .. "Wrist")
	if not (sh and el and wr) then return false end
	local function place(m, tr) m.Part1.CFrame = m.Part0.CFrame * m.C0 * tr * m.C1:Inverse() end
	place(sh, CFrame.Angles(0, math.rad(p.yaw) * sgn, 0) * CFrame.Angles(math.rad(p.up), 0, 0))
	place(el, CFrame.Angles(0, math.rad(p.twist) * sgn, 0) * CFrame.Angles(math.rad(p.elbow), 0, 0))
	place(wr, CFrame.new())
	return true
end

local function buildProfileModel()
	if vpModel then vpModel:Destroy() vpModel = nil end
	local char = LP.Character or LP.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid", 10)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if not (hum and hrp) or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
	task.wait(1.5) -- รอให้ชุด/ผมโหลด
	char.Archivable = true
	local clone = char:Clone()
	if not clone then return end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") then d:Destroy() end
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then d.Anchored = true end
	end
	local chum = clone:FindFirstChildOfClass("Humanoid")
	if chum then chum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
	local chrp = clone:FindFirstChild("HumanoidRootPart")
	if not chrp then return end
	clone.PrimaryPart = chrp
	clone:PivotTo(CFrame.new(0, 0, 0))
	local okR = armPose(clone, "Right", POSE.Right)
	local okL = armPose(clone, "Left", POSE.Left)
	if not (okR and okL) then return end
	clone.Parent = vp
	local cam = new("Camera", { FieldOfView = 30, CFrame = CFrame.lookAt(Vector3.new(0, 1.3, -7.6), Vector3.new(0, 1.05, 0)) }, vp)
	vp.CurrentCamera = cam
	vpModel = clone
	vp.Visible = true
	avatarImg.Visible = false
end

