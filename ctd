local rot, acc, breathe = 0, 0, 0
table.insert(conns, RunService.Heartbeat:Connect(function(dt)
	rot = (rot + dt * 60) % 360
	JH.grad.Rotation = rot
	JH.logoGrad.Rotation = rot
	acc = acc + dt
	if acc >= 0.25 then
		acc = 0
		local m = fmt(getMoney())
		JH.moneyLbl.Text = "$ " .. m
		JH.profMoney.Text = "$ " .. m
		pcall(updateCard)
	end
	if vpModel and win.Visible then
		breathe = breathe + dt
		vpModel:PivotTo(CFrame.new(0, math.sin(breathe * 1.6) * 0.04, 0) * CFrame.Angles(0, math.rad(-22 + math.sin(breathe * 0.9) * 9), 0))
	end
end))

-- ฟีเจอร์ Game วนตามเวลา
local last = {}
local function due(k, iv)
	local n = os.clock()
	iv = math.max(0.03, tonumber(iv) or 1)
	if not last[k] or n - last[k] >= iv then
		last[k] = n
		return true
	end
	return false
end
task.spawn(function()
	while gui.Parent do
		if flags.vote and due("vote", CFG.voteInterval) then fireEvent("ModeVote", CFG.voteMode) end
		if flags.speed and due("speed", CFG.speedInterval) then invokeFunc("ChangeSpeed", CFG.speed) end
		if flags.skip and due("skip", CFG.skipInterval) then fireEvent("WaveSkip") end
		if flags.again and due("again", CFG.againInterval) then fireEvent("PlayAgain") end
		task.wait()
	end
end)

