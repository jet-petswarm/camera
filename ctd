	local old
	old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		if recording and getnamecallmethod() == "FireServer" and (self == TowerAdd or self == TowerUpgrade or self == TowerSell) then
			local a = ...
			if typeof(a) == "table" then
				local remote = self
				task.spawn(function()
					local ok, err = pcall(onRecord, remote, a)
					if not ok then warn("[JetHub Camera] record error:", err) end
				end)
			end
		end
		return old(self, ...)
	end))
	hookOK = true
end

