local function nameForStep(s)
	if s.type == "add" then return s.name or "?" end
	if s.tpos then
		local tp = Vector3.new(unpack(s.tpos))
		for _, o in ipairs(steps) do
			if o.type == "add" and o.pos and (Vector3.new(unpack(o.pos)) - tp).Magnitude <= 6 then return o.name end
		end
	end
	return "tower"
end

local refreshPending = false
local function refreshSteps()
	for _, ch in ipairs(stepList:GetChildren()) do
		if ch:IsA("Frame") then ch:Destroy() end
	end
	for i, s in ipairs(steps) do
		local row = new("Frame", { Size = UDim2.new(1, -6, 0, 30), BackgroundColor3 = C.row, BorderSizePixel = 0, LayoutOrder = i }, stepList)
		corner(row, 6)
		txt(row, string.format("#%d %s %s", i, TYPE_LBL[s.type] or s.type, nameForStep(s)), { Size = UDim2.fromOffset(170, 30), Position = UDim2.fromOffset(6, 0), TextSize = 12 })

		if s.type ~= "sell" then
			box(row, string.format("%.0f", s.price or 0), { Size = UDim2.fromOffset(96, 22), Position = UDim2.fromOffset(180, 4), TextXAlignment = Enum.TextXAlignment.Center }, function(t, b)
				local n = parseNum(t)
				if n then
					s.price = n
					s.locked = true -- แก้เองแล้วล็อคให้อัตโนมัติ
				end
				UI.refresh()
			end)
			local lk = btn(row, s.locked and "LOCK" or "free", { Size = UDim2.fromOffset(44, 22), Position = UDim2.fromOffset(280, 4), BackgroundColor3 = s.locked and C.acc or C.off, TextColor3 = s.locked and C.bg or C.text })
			lk.MouseButton1Click:Connect(function()
				s.locked = not s.locked
				UI.refresh()
			end)
		else
			txt(row, "(ไม่มีราคา)", { Size = UDim2.fromOffset(140, 30), Position = UDim2.fromOffset(184, 0), TextColor3 = C.sub, TextSize = 11 })
		end

		btn(row, "^", { Size = UDim2.fromOffset(24, 22), Position = UDim2.fromOffset(328, 4) }, function()
			if i > 1 then steps[i], steps[i - 1] = steps[i - 1], steps[i] UI.refresh() end
		end)
		btn(row, "v", { Size = UDim2.fromOffset(24, 22), Position = UDim2.fromOffset(356, 4) }, function()
			if i < #steps then steps[i], steps[i + 1] = steps[i + 1], steps[i] UI.refresh() end
		end)
		btn(row, "x", { Size = UDim2.fromOffset(24, 22), Position = UDim2.fromOffset(384, 4), BackgroundColor3 = C.bad }, function()
			table.remove(steps, i)
			UI.refresh()
		end)
		btn(row, "Do", { Size = UDim2.fromOffset(44, 22), Position = UDim2.fromOffset(412, 4), BackgroundColor3 = C.acc2 }, function()
			if running or recording then status("หยุดอัด/เล่นก่อนถึงจะใช้ปุ่ม Do ได้") return end
			task.spawn(function()
				local t0 = os.clock()
				local ok = execStep(s, function() return os.clock() - t0 < 20 end, i)
				status(ok and ("Step " .. i .. " สำเร็จ") or ("Step " .. i .. " ไม่สำเร็จ"))
			end)
		end)
	end
	stepsStatus.Text = "Steps: " .. #steps
end
UI.refresh = function()
	if refreshPending then return end
	refreshPending = true
	task.defer(function()
		refreshPending = false
		pcall(refreshSteps)
	end)
end

