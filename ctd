local function showTab(i, animate)
	for j, t in ipairs(tabs) do
		local on = (j == i)
		t.lbl.TextColor3 = on and C.text or C.sub
		t.ico.TextTransparency = on and 0 or 0.35
		if not on then t.page.Visible = false end
	end
	local cur = tabs[i]
	cur.page.Visible = true
	local y = TAB_Y0 + (i - 1) * (TAB_H + 4)
	if animate then
		cur.page.GroupTransparency = 1
		cur.page.Position = UDim2.fromOffset(0, 14)
		tw(cur.page, 0.3, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, QUINT)
		tw(JH.indicator, 0.3, { Position = UDim2.fromOffset(7, y) }, QUINT)
	else
		cur.page.GroupTransparency = 0
		cur.page.Position = UDim2.fromOffset(0, 0)
		JH.indicator.Position = UDim2.fromOffset(7, y)
	end
	CFG.tab = i
end

local function newPage(key, icon)
	local idx = #tabs + 1
	local page = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, content)
	local b = new("TextButton", {
		Size = UDim2.new(1, -14, 0, TAB_H), Position = UDim2.fromOffset(7, TAB_Y0 + (idx - 1) * (TAB_H + 4)),
		BackgroundTransparency = 1, Text = "", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 3,
	}, side)
	local ico = txt(b, icon, { Size = UDim2.fromOffset(26, TAB_H), Position = UDim2.fromOffset(14, 0), TextSize = 16, TextXAlignment = CENTER, ZIndex = 3 })
	local lbl = txt(b, "", { Size = UDim2.new(1, -52, 1, 0), Position = UDim2.fromOffset(46, 0), Font = FONTB, TextColor3 = C.sub, ZIndex = 3 })
	bind(lbl, "Text", key)
	tabs[idx] = { page = page, btn = b, lbl = lbl, ico = ico }
	b.MouseEnter:Connect(function() if CFG.tab ~= idx then tw(lbl, 0.12, { TextColor3 = C.text }) end end)
	b.MouseLeave:Connect(function() if CFG.tab ~= idx then tw(lbl, 0.15, { TextColor3 = C.sub }) end end)
	b.MouseButton1Click:Connect(function()
		if CFG.tab ~= idx then showTab(idx, true) saveCfg() end
	end)
	return page
end

