local function saveMacro(name)
	name = cleanName(name)
	if name == "" then status("name_first") return false end
	if #steps == 0 then status("nothing_to_save") return false end
	if not writefile then status("no_writefile") return false end
	ensureDir()
	writefile(filePath(name), HttpService:JSONEncode({ v = 2, steps = steps, prices = prices }))
	CFG.selected = name
	saveCfg()
	status("saved", name, #steps)
	return true
end
local pendingSave = 0
autoSave = function(nameOverride, now)
	if recording or not writefile then return end
	pendingSave = pendingSave + 1
	local my = pendingSave
	local function doSave()
		if my ~= pendingSave or recording then return end
		local name = nameOverride or CFG.selected
		if not name or name == "" then name = "AutoMacro" end
		name = cleanName(name)
		if name == "" then name = "AutoMacro" end
		local ok = pcall(function()
			ensureDir()
			writefile(filePath(name), HttpService:JSONEncode({ v = 2, steps = steps, prices = prices }))
		end)
		if ok and CFG.selected ~= name then CFG.selected = name saveCfg() end
	end
	if now then doSave() else task.delay(0.4, doSave) end
end

local function loadMacro(name)
	if not (isfile and readfile and isfile(filePath(name))) then status("file_missing", tostring(name)) return false end
	local ok, t = pcall(function() return HttpService:JSONDecode(readfile(filePath(name))) end)
	if ok and type(t) == "table" then
		if t.steps then
			steps = t.steps
			prices = t.prices or {}
		else
			-- รูปแบบเก่า (array ของสเต็ป พร้อม price ในสเต็ป)
			steps = t
			prices = {}
			recompute()
			for i, s in ipairs(steps) do
				local m = meta[i]
				if m and s.type ~= "sell" and (s.price or 0) > 0 then
					local p = pslot(m.unit, m.stage, true)
					if p.price == 0 then p.price = s.price end
					if s.locked then p.locked = true end
				end
			end
		end
		recompute()
		curIdx = 0
		CFG.selected = name
		saveCfg()
		UI.refresh()
		status("loaded", name, #steps)
		return true
	end
	status("read_fail")
	return false
end

--------------------------------------------------------------------------
-- Share / Import (โค้ดแชร์ = JHC1: + base64 ของ JSON  ปลอดภัย ไม่รันโค้ด)
--------------------------------------------------------------------------
local B64C = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64E, B64D = {}, {}
for i = 1, 64 do
	local ch = B64C:sub(i, i)
	B64E[i - 1] = ch
	B64D[ch:byte()] = i - 1
end
local function b64enc(str)
	local out = {}
	for i = 1, #str, 3 do
		local x, y, z = str:byte(i, i + 2)
		local v = x * 65536 + (y or 0) * 256 + (z or 0)
		local c1 = math.floor(v / 262144) % 64
		local c2 = math.floor(v / 4096) % 64
		local c3 = math.floor(v / 64) % 64
		local c4 = v % 64
		out[#out + 1] = B64E[c1] .. B64E[c2] .. (y and B64E[c3] or "=") .. (z and B64E[c4] or "=")
	end
	return table.concat(out)
end
local function b64dec(str)
	str = str:gsub("[^%w%+/=]", "")
	local out = {}
	for i = 1, #str, 4 do
		local a, b, c, d = str:byte(i, i + 3)
		local va, vb = B64D[a or 0], B64D[b or 0]
		if va == nil or vb == nil then return nil end
		local vc = (c and c ~= 61) and B64D[c] or nil
		local vd = (d and d ~= 61) and B64D[d] or nil
		if (c and c ~= 61 and vc == nil) or (d and d ~= 61 and vd == nil) then return nil end
		local v = va * 262144 + vb * 4096 + (vc or 0) * 64 + (vd or 0)
		local o1, o2, o3 = math.floor(v / 65536) % 256, math.floor(v / 256) % 256, v % 256
		if vc == nil then out[#out + 1] = string.char(o1)
		elseif vd == nil then out[#out + 1] = string.char(o1, o2)
		else out[#out + 1] = string.char(o1, o2, o3) end
	end
	return table.concat(out)
end

local function numArr(t, n)
	if type(t) ~= "table" then return nil end
	for i = 1, n do if type(t[i]) ~= "number" then return nil end end
	local o = {}
	for i = 1, n do o[i] = t[i] end
	return o
end
local function cleanSteps(raw)
	if type(raw) ~= "table" or #raw == 0 or #raw > 3000 then return nil end
	local out = {}
	for _, st in ipairs(raw) do
		if type(st) ~= "table" then return nil end
		local ty = st.type
		if ty == "add" then
			local pos, cf = numArr(st.pos, 3), numArr(st.cframe, 12)
			if not pos or not cf or type(st.name) ~= "string" then return nil end
			out[#out + 1] = {
				type = "add", name = st.name:sub(1, 60),
				unitId = (type(st.unitId) == "string") and st.unitId:sub(1, 80) or nil,
				cframe = cf, pos = pos, delay = tonumber(st.delay) or 0,
			}
		elseif ty == "upgrade" or ty == "sell" then
			local tp = numArr(st.tpos, 3)
			if not tp then return nil end
			out[#out + 1] = { type = ty, tpos = tp, delay = tonumber(st.delay) or 0 }
		else
			return nil
		end
	end
	return out
end
local function cleanPrices(raw)
	local out = {}
	if type(raw) ~= "table" then return out end
	for unit, stages in pairs(raw) do
		if type(unit) == "string" and type(stages) == "table" then
			local u = {}
			for k, p in pairs(stages) do
				if type(p) == "table" and tonumber(k) then
					u[tostring(k)] = { price = tonumber(p.price) or 0, locked = p.locked == true }
				end
			end
			out[unit:sub(1, 60)] = u
		end
	end
	return out
end

local function setClip(str)
	local f = setclipboard or toclipboard or set_clipboard or (Clipboard and Clipboard.set)
	if not f then return false end
	return (pcall(f, str))
end
local function getClip()
	local f = getclipboard or (Clipboard and Clipboard.get)
	if not f then return nil end
	local ok, v = pcall(f)
	return ok and type(v) == "string" and v or nil
end

local function makeShareCode(name)
	local data
	if isfile and readfile and isfile(filePath(name)) then
		local ok, t = pcall(function() return HttpService:JSONDecode(readfile(filePath(name))) end)
		if ok and type(t) == "table" and t.steps then data = { steps = t.steps, prices = t.prices } end
	end
	if not data and name == CFG.selected and #steps > 0 then data = { steps = steps, prices = prices } end
	if not data then return nil end
	local ok, js = pcall(HttpService.JSONEncode, HttpService, { n = name, v = 2, steps = data.steps, prices = data.prices or {} })
	if not ok then return nil end
	return "JHC1:" .. b64enc(js)
end

-- คืน (ชื่อมาโคร, จำนวนสเต็ป) หรือ nil
local function importCode(code)
	code = tostring(code or ""):gsub("%s", "")
	if code == "" then return nil, "empty" end
	local body = code:match("^JHC1:(.+)$")
	if not body then return nil, "bad" end
	local js = b64dec(body)
	if not js then return nil, "bad" end
	local ok, t = pcall(function() return HttpService:JSONDecode(js) end)
	if not ok or type(t) ~= "table" then return nil, "bad" end
	local st = cleanSteps(t.steps)
	if not st then return nil, "bad" end
	if not writefile then return nil, "nowrite" end
	local name = cleanName(t.n)
	if name == "" then name = "Imported" end
	local base, n = name, 1
	while isfile and isfile(filePath(name)) do
		n = n + 1
		name = base .. "_" .. n
	end
	ensureDir()
	local w = pcall(writefile, filePath(name), HttpService:JSONEncode({ v = 2, steps = st, prices = cleanPrices(t.prices) }))
	if not w then return nil, "nowrite" end
	return name, #st
end

