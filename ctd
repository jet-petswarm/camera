end

local function rebuildStages(animate)
	for _, ch in ipairs(stageList:GetChildren()) do
		if ch:IsA("Frame") or ch:IsA("TextLabel") then ch:Destroy() end
	end
	if not selUnit then
		unitTitle.Text = ""
		txtK(stageList, "pick_first", { Size = UDim2.new(1, -6, 0, 30), TextColor3 = C.sub })
		return
	end
	local maxStage, uses = 1, {}
	for i, s in ipairs(steps) do
		local m = meta[i]
		if m and m.unit == selUnit and s.type ~= "sell" then
			maxStage = math.max(maxStage, m.stage)
			uses[m.stage] = (uses[m.stage] or 0) + 1
		end
	end
	unitTitle.Text = T("unit_title", selUnit, math.floor(maxStage))
	for st = 1, maxStage do
		local p = pslot(selUnit, st, true)
		local row = new("Frame", { Size = UDim2.new(1, -6, 0, 36), BackgroundColor3 = C.row, BorderSizePixel = 0, LayoutOrder = st }, stageList)
		corner(row, 9)
		txt(row, T(st == 1 and "stage_place" or "stage_up", st), { Size = UDim2.new(0, 190, 1, 0), Position = UDim2.fromOffset(12, 0), Font = Enum.Font.GothamBold })
		txt(row, "x" .. (uses[st] or 0), { Size = UDim2.fromOffset(40, 36), Position = UDim2.fromOffset(200, 0), TextColor3 = C.sub, TextSize = 12 })
		box(row, string.format("%.0f", p.price or 0), { Size = UDim2.fromOffset(120, 26), Position = UDim2.fromOffset(250, 5), TextXAlignment = Enum.TextXAlignment.Center }, function(t)
			local n = parseNum(t)
			if n then
				p.price = n
				p.locked = true -- แก้เองแล้วล็อคอัตโนมัติ ไม่ให้ระบบเรียนรู้ทับ
			end
			rebuildStages(false)
		end)
		local locked = p.locked or CFG.priceLockAll
		local lk = btn(row, locked and T("lock_on") or T("lock_off"), { Size = UDim2.fromOffset(80, 26), Position = UDim2.fromOffset(382, 5), BackgroundColor3 = locked and C.acc or C.off, TextColor3 = locked and C.bg or C.text })
		lk.MouseButton1Click:Connect(function()
			p.locked = not p.locked
			rebuildStages(false)
		end)
	end
	if animate then
		stageGroup.GroupTransparency = 1
		tw(stageGroup, 0.3, { GroupTransparency = 0 }, QUINT)
	end
end

local function rebuildChips()
	for _, ch in ipairs(chipBar:GetChildren()) do
		if ch:IsA("TextButton") or ch:IsA("TextLabel") then ch:Destroy() end
	end
	chipBtns = {}
	local units = unitList()
	if #units == 0 then
		txtK(chipBar, "no_units", { Size = UDim2.fromOffset(160, 30), TextColor3 = C.sub })
		selUnit, pendingUnit = nil, nil
		return
	end
	local found = false
	for _, u in ipairs(units) do if u == selUnit then found = true end end
	if not found then selUnit = nil end
	for _, u in ipairs(units) do
		local b = btn(chipBar, u, { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(20, 26), BackgroundColor3 = C.row }, nil, true)
		new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, b)
		b.MouseButton1Click:Connect(function()
			pendingUnit = u
			paintChips()
		end)
		chipBtns[u] = b
	end
	paintChips()
end

selectBtn.MouseButton1Click:Connect(function()
	if not pendingUnit then status("need_unit") return end
	selUnit = pendingUnit
	rebuildStages(true)
	status("unit_selected", selUnit)
end)

