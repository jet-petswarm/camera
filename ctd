local refreshPending = false
local function refreshAll()
	recompute()
	pcall(refreshSteps)
	pcall(rebuildChips)
	pcall(rebuildStages, false)
end
UI.refresh = function()
	if refreshPending then return end
	refreshPending = true
	task.defer(function()
		refreshPending = false
		refreshAll()
	end)
end

