local C = {
	bg = Color3.fromRGB(8, 10, 24), side = Color3.fromRGB(13, 17, 38), row = Color3.fromRGB(20, 26, 56),
	sel = Color3.fromRGB(34, 46, 104), text = Color3.fromRGB(235, 240, 255), sub = Color3.fromRGB(125, 140, 190),
	acc = Color3.fromRGB(0, 200, 255), acc2 = Color3.fromRGB(255, 140, 40), ok = Color3.fromRGB(70, 225, 130),
	warn = Color3.fromRGB(255, 205, 70), bad = Color3.fromRGB(255, 85, 105), off = Color3.fromRGB(52, 60, 112),
}
local QUAD, QUINT, BACK = Enum.EasingStyle.Quad, Enum.EasingStyle.Quint, Enum.EasingStyle.Back
local OUT = Enum.EasingDirection.Out

local function tw(o, t, props, style, dir)
	local tween = TweenService:Create(o, TweenInfo.new(t, style or QUAD, dir or OUT), props)
	tween:Play()
	return tween
end

local function new(cls, props, parent)
	local o = Instance.new(cls)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o, r) new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function apply(o, props) for k, v in pairs(props or {}) do o[k] = v end return o end

local function txt(parent, t, props)
	local l = new("TextLabel", {
		BackgroundTransparency = 1, Text = t, TextColor3 = C.text, Font = Enum.Font.GothamMedium,
		TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	}, parent)
	return apply(l, props)
end
local function txtK(parent, key, props, ...)
	local l = txt(parent, "", props)
	bind(l, "Text", key, ...)
	return l
end

local function hoverable(b, useScale)
	b:SetAttribute("base", b.BackgroundColor3)
	local sc = useScale and new("UIScale", { Scale = 1 }, b) or nil
	b.MouseEnter:Connect(function()
		tw(b, 0.12, { BackgroundColor3 = b:GetAttribute("base"):Lerp(Color3.new(1, 1, 1), 0.14) })
	end)
	b.MouseLeave:Connect(function()
		tw(b, 0.15, { BackgroundColor3 = b:GetAttribute("base") })
		if sc then tw(sc, 0.1, { Scale = 1 }) end
	end)
	if sc then
		b.MouseButton1Down:Connect(function() tw(sc, 0.08, { Scale = 0.96 }) end)
		b.MouseButton1Up:Connect(function() tw(sc, 0.14, { Scale = 1 }, BACK) end)
	end
end
local function setBtn(b, bg, fg)
	b:SetAttribute("base", bg)
	tw(b, 0.2, { BackgroundColor3 = bg, TextColor3 = fg or b.TextColor3 })
end

local function btn(parent, t, props, cb, small)
	local b = new("TextButton", {
		Text = t, BackgroundColor3 = C.sel, TextColor3 = C.text, Font = Enum.Font.GothamBold,
		TextSize = 12, AutoButtonColor = false, BorderSizePixel = 0,
	}, parent)
	corner(b, 7)
	apply(b, props)
	hoverable(b, not small)
	if cb then b.MouseButton1Click:Connect(cb) end
	return b
end
local function btnK(parent, key, props, cb, small, ...)
	local b = btn(parent, "", props, cb, small)
	bind(b, "Text", key, ...)
	return b
end

local function box(parent, text, props, onDone)
	local b = new("TextBox", {
		Text = text or "", BackgroundColor3 = C.bg, TextColor3 = C.text, PlaceholderColor3 = C.sub,
		Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false, BorderSizePixel = 0,
	}, parent)
	corner(b, 7)
	local st = new("UIStroke", { Color = C.acc, Thickness = 1, Transparency = 1 }, b)
	b.Focused:Connect(function() tw(st, 0.15, { Transparency = 0.2 }) end)
	b.FocusLost:Connect(function()
		tw(st, 0.2, { Transparency = 1 })
		if onDone then onDone(b.Text, b) end
	end)
	return apply(b, props)
end

-- สวิตช์แบบใหม่: แถบสีด้านซ้าย + สวิตช์ยืด/เด้ง + glow
local function toggle(parent, labelKey, init, props, cb, descKey)
	local row = new("Frame", { BackgroundColor3 = C.row, BorderSizePixel = 0 }, parent)
	corner(row, 10)
	apply(row, props)
	local accent = new("Frame", { Size = UDim2.new(0, 3, 0.5, 0), Position = UDim2.new(0, 0, 0.25, 0), BackgroundColor3 = C.acc, BackgroundTransparency = 1, BorderSizePixel = 0 }, row)
	corner(accent, 2)
	if descKey then
		txtK(row, labelKey, { Size = UDim2.new(1, -86, 0, 20), Position = UDim2.fromOffset(14, 5), Font = Enum.Font.GothamBold })
		txtK(row, descKey, { Size = UDim2.new(1, -86, 0, 16), Position = UDim2.fromOffset(14, 25), TextSize = 11, TextColor3 = C.sub })
	else
		txtK(row, labelKey, { Size = UDim2.new(1, -86, 1, 0), Position = UDim2.fromOffset(14, 0), Font = Enum.Font.GothamBold })
	end
	local track = new("TextButton", {
		Text = "", Size = UDim2.fromOffset(48, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		BackgroundColor3 = C.off, BorderSizePixel = 0, AutoButtonColor = false,
	}, row)
	corner(track, 12)
	local glow = new("UIStroke", { Color = C.acc, Thickness = 2, Transparency = 1 }, track)
	local knob = new("Frame", { Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, track)
	corner(knob, 9)
	local state = false
	local function visual(v, animate)
		local d = animate and 0.22 or 0
		local x = v and 27 or 3
		if animate then
			-- ยืดตามทิศทางก่อน แล้วค่อยเด้งเข้าที่
			tw(knob, 0.09, { Size = UDim2.fromOffset(26, 18), Position = UDim2.fromOffset(v and 19 or 3, 3) })
			task.delay(0.09, function()
				tw(knob, 0.2, { Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(v and 27 or 3, 3) }, BACK)
			end)
		else
			knob.Size = UDim2.fromOffset(18, 18)
			knob.Position = UDim2.fromOffset(x, 3)
		end
		tw(track, d, { BackgroundColor3 = v and C.acc or C.off })
		tw(glow, d, { Transparency = v and 0.55 or 1 })
		tw(accent, d, { BackgroundTransparency = v and 0 or 1 })
	end
	local function set(v, silent)
		state = v and true or false
		visual(state, not silent)
		if not silent and cb then cb(state) end
	end
	track.MouseButton1Click:Connect(function() set(not state) end)
	row.MouseEnter:Connect(function() tw(row, 0.12, { BackgroundColor3 = C.row:Lerp(Color3.new(1, 1, 1), 0.06) }) end)
	row.MouseLeave:Connect(function() tw(row, 0.15, { BackgroundColor3 = C.row }) end)
	state = init and true or false
	visual(state, false)
	return set, row
end

local function counter()
	local n = 0
	return function() n = n + 1 return n end
end

