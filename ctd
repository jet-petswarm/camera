local function getMoney()
	local ls = LP:FindFirstChild("leaderstats")
	local m = ls and ls:FindFirstChild("Money")
	if m then
		local ok, v = pcall(function() return m.Value end)
		if ok then return parseNum(v) end
	end
	return nil
end

