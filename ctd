-- เอฟเฟกต์ปุ่ม: สว่างเมื่อชี้ + ยุบเมื่อกด
local function fx(b, down)
	local sc = new("UIScale", { Scale = 1 }, b)
	local shine = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0 }, b)
	local cr = b:FindFirstChildOfClass("UICorner")
	if cr then new("UICorner", { CornerRadius = cr.CornerRadius }, shine) end
	b.MouseEnter:Connect(function() tw(shine, 0.12, { BackgroundTransparency = 0.9 }) end)
	b.MouseLeave:Connect(function()
		tw(shine, 0.16, { BackgroundTransparency = 1 })
		tw(sc, 0.1, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function() tw(sc, 0.08, { Scale = down or 0.96 }) end)
	b.MouseButton1Up:Connect(function() tw(sc, 0.16, { Scale = 1 }, BACK) end)
end

-- ปุ่ม: role = acc (ไล่สีธีม) / ok / bad / warn / ghost
local function btn(parent, t, role, props, cb)
	local b = new("TextButton", {
		Text = t, BackgroundColor3 = Color3.new(1, 1, 1), TextColor3 = C.ink, Font = FONTB,
		TextSize = 12, AutoButtonColor = false, BorderSizePixel = 0,
	}, parent)
	corner(b, 9)
	apply(b, props)
	if role == "acc" then
		accGrad(b, 0)
	elseif role == "ghost" then
		b.BackgroundColor3 = C.card2
		b.TextColor3 = C.text
		stroke(b, C.line, 1, 0.4)
	elseif role == "bad" then
		paint(function() b.BackgroundColor3 = C.bad end)
		b.TextColor3 = Color3.new(1, 1, 1)
	else
		paint(function() b.BackgroundColor3 = C[role] or C.ok end)
	end
	fx(b)
	if cb then b.MouseButton1Click:Connect(cb) end
	return b
end
local function btnK(parent, key, role, props, cb)
	local b = btn(parent, "", role, props, cb)
