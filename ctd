-- อัด
--------------------------------------------------------------------------
local function onRecord(remote, a)
	if not recording then return end
	local now = os.clock()
	local prevT = lastT
	local delay = now - lastT
	lastT = now
	local before = getMoney()
	local step, pos, base, tid
	if remote == TowerAdd then
		if typeof(a.CFrame) ~= "CFrame" or type(a.Name) ~= "string" then return end
		local cf = a.CFrame
		local p = (typeof(a.Pos) == "Vector3") and a.Pos or cf.Position
		pos = p
		base = nearCount(p, 3) or 0
		step = { type = "add", name = a.Name, unitId = a.UnitId, cframe = { cf:GetComponents() }, pos = { p.X, p.Y, p.Z }, delay = delay }
	elseif remote == TowerUpgrade or remote == TowerSell then
		if not a.Id then return end
		tid = a.Id
		local inst = findTowerById(a.Id)
		local p = inst and posOf(inst)
		if not p then status("tower_pos_missing") return end
		step = { type = (remote == TowerUpgrade) and "upgrade" or "sell", tpos = { p.X, p.Y, p.Z }, delay = delay }
		step._inst = inst
	else
		return
	end
	local inst = step._inst
	step._inst = nil

	-- ใส่ไว้ก่อน (ชั่วคราว) เพื่อรักษาลำดับ แล้วตรวจว่าเงินลดจริงถึงจะเก็บ ไม่งั้นลบออก
	table.insert(steps, step)
	recompute()
	UI.refresh()
	status("rec_progress", #steps)

	task.spawn(function()
		local tFire = now
		local drop, prev = 0, before
		local confirmed = false
		local gained = false
		local t0 = os.clock()
		local firstDrop
		while os.clock() - t0 < 2.5 do
			task.wait(0.03)
			local m = getMoney()
			if prev and m then
				if m < prev then
					drop = drop + (prev - m)
					firstDrop = firstDrop or os.clock()
				elseif m > prev and step.type == "sell" then
					gained = true
				end
			end
			if m then prev = m end
			-- ยืนยันฝั่งเซิร์ฟเวอร์ (ใช้เป็นตัวเสริม / ตอนอ่านเงินไม่ได้)
			if step.type == "add" then
				local n = nearCount(pos, 3)
				if n and n > base then confirmed = true end
			elseif step.type == "upgrade" then
				local e = upEvt[tid]
				if e and e.t >= tFire then confirmed = true end
			else
				if inst and (not inst.Parent or not inst:IsDescendantOf(workspace)) then confirmed = true end
			end
			if step.type == "sell" then
				if confirmed or gained then break end
			elseif before then
				if firstDrop and os.clock() - firstDrop > 0.4 then break end -- เก็บยอดลดให้ครบ
			elseif confirmed then
				break -- อ่านเงินไม่ได้: เชื่อการยืนยันจากเซิร์ฟเวอร์
			end
		end
		local accepted
		if step.type == "sell" then accepted = confirmed or gained
		elseif before then accepted = drop > 0
		else accepted = confirmed end

		local idx = table.find(steps, step)
		if not accepted then
			if idx then table.remove(steps, idx) end
			if lastT == now then lastT = prevT end
			recompute()
			UI.refresh()
			status("rec_rejected")
			autoSave()
			return
		end
		if step.type ~= "sell" and drop > 0 then
			recompute()
			local m = idx and meta[idx]
			if m then
				local p = pslot(m.unit, m.stage, true)
				if not (CFG.priceLockAll or p.locked) then p.price = drop end
			end
		end
		autoSave()
		UI.refresh()
	end)
end

