local steps = {}
local recording, running = false, false
local runId = 0
local lastT = 0
local UI = { refresh = function() end, status = function() end, playOff = function() end }

local function status(m) UI.status(m) end

local function measureDrop(before, timeout)
	local drop, t = 0, os.clock()
	while os.clock() - t < timeout do
		task.wait(0.1)
		local m = getMoney()
		if m then drop = math.max(drop, before - m) end
	end
	return drop
end

local function onRecord(remote, a)
	if not recording then return end
	local now = os.clock()
	local delay = now - lastT
	lastT = now
	local before = getMoney()
	local step
	if remote == TowerAdd then
		if typeof(a.CFrame) ~= "CFrame" or type(a.Name) ~= "string" then return end
		local cf = a.CFrame
		local p = (typeof(a.Pos) == "Vector3") and a.Pos or cf.Position
		step = { type = "add", name = a.Name, unitId = a.UnitId, cframe = { cf:GetComponents() }, pos = { p.X, p.Y, p.Z }, delay = delay, price = 0 }
	elseif remote == TowerUpgrade or remote == TowerSell then
		if not a.Id then return end
		local inst = findTowerById(a.Id)
		local p = inst and posOf(inst)
		if not p then status("หาตำแหน่งตัวละครไม่เจอ ข้ามสเต็ปนี้") return end
		step = { type = (remote == TowerUpgrade) and "upgrade" or "sell", tpos = { p.X, p.Y, p.Z }, delay = delay, price = 0 }
	else
		return
	end
	table.insert(steps, step)
	UI.refresh()
	status("Recording... " .. #steps .. " steps")
	if before and step.type ~= "sell" then
		task.spawn(function()
			local d = measureDrop(before, 3)
			if d > 0 then step.price = d UI.refresh() end
		end)
	end
end

local function waitMoney(step, alive, idx)
	local price = step.price or 0
	if step.type == "sell" or price <= 0 then return true end
	local t0 = os.clock()
	while alive() do
		local m = getMoney()
		if m == nil then
			if CFG.useDelay and step.delay then task.wait(math.min(step.delay, 30)) end
			return true
		end
		if m >= price then return true end
		status(string.format("Step %d รอเงิน %s / %s", idx or 0, fmt(m), fmt(price)))
		if CFG.moneyTimeout > 0 and os.clock() - t0 > CFG.moneyTimeout then return false end
		task.wait(0.15)
	end
	return "stop"
end

local function attemptAdd(step, alive, vt)
	if not TowerAdd then return false, 0, "remote ไม่พร้อม (เข้าแมตช์ก่อน)" end
	local id = unitIdFor(step)
	if not id then return false, 0, "ไม่พบยูนิต " .. tostring(step.name) .. " ใน Slot" end
	local pos = Vector3.new(unpack(step.pos))
	local cf = CFrame.new(unpack(step.cframe))
	if (nearCount(pos, 2) or 0) >= 1 then return true, 0, "มีตัวอยู่แล้ว" end
	local base = nearCount(pos, 3) or 0
	local before = getMoney()
	TowerAdd:FireServer({ UnitId = id, CFrame = cf, Name = step.name, Pos = pos })
	local t, drop = os.clock(), 0
	while alive() and os.clock() - t < vt do
		task.wait(0.05)
		local m = getMoney()
		if before and m then drop = math.max(drop, before - m) end
		local n = nearCount(pos, 3)
		if n and n > base then
			task.wait(0.25)
			local m2 = getMoney()
			if before and m2 then drop = math.max(drop, before - m2) end
			return true, drop
		end
		if n == nil and drop > 0 then return true, drop end
		if n == nil and before == nil and os.clock() - t > 0.6 then return true, 0 end
	end
	return false, drop, "วางไม่สำเร็จ"
end

local function attemptTarget(step, alive, vt)
	if not (TowerUpgrade and TowerSell) then return false, 0, "remote ไม่พร้อม (เข้าแมตช์ก่อน)" end
	if not step.tpos then return false, 0, "ไม่มีตำแหน่ง" end
	local id, inst = findNearestTower(Vector3.new(unpack(step.tpos)), 10)
	if not id then return false, 0, "ไม่พบตัวละครตรงตำแหน่งนี้" end
	local before = getMoney()
	local t, drop = os.clock(), 0
	if step.type == "upgrade" then
		TowerUpgrade:FireServer({ Id = id })
		while alive() and os.clock() - t < vt do
			task.wait(0.05)
			local m = getMoney()
			if before and m then drop = math.max(drop, before - m) end
			local e = upEvt[id]
			if e and e.t >= t then
				task.wait(0.2)
				local m2 = getMoney()
				if before and m2 then drop = math.max(drop, before - m2) end
				return true, drop
			end
			if (step.price or 0) > 0 and drop >= step.price * 0.9 then return true, drop end
		end
		return false, drop, "อัพไม่สำเร็จ"
	else
		TowerSell:FireServer({ Id = id })
		while alive() and os.clock() - t < vt do
			task.wait(0.05)
			if not inst.Parent or not inst:IsDescendantOf(workspace) then return true, 0 end
		end
		return false, 0, "ขายไม่สำเร็จ"
	end
end

local function execStep(step, alive, idx)
	local retry = math.max(1, tonumber(CFG.retry) or 3)
	local vt = tonumber(CFG.verifyTimeout) or 3
	for attempt = 1, retry do
		if not alive() then return false end
		local g = waitMoney(step, alive, idx)
		if g == "stop" then return false end
		if g == false then
			warn("[JetHub Camera] step " .. tostring(idx) .. " รอเงินหมดเวลา")
			return false
		end
		local ok, drop, why
		if step.type == "add" then ok, drop, why = attemptAdd(step, alive, vt)
		else ok, drop, why = attemptTarget(step, alive, vt) end
		if ok then
			if drop and drop > 0 and CFG.autoLearn and not (CFG.priceLockAll or step.locked) then
				step.price = drop
				UI.refresh()
			end
			return true
		end
		warn(string.format("[JetHub Camera] step %s ลองครั้งที่ %d: %s", tostring(idx), attempt, tostring(why)))
		task.wait(0.4)
	end
	return false
end

local function stopMacro()
	running = false
	runId = runId + 1
end

local function runMacro(startIdx)
	if running or recording then return false end
	if #steps == 0 then status("ยังไม่มีสเต็ป (อัดก่อน หรือโหลดมาโคร)") return false end
	running = true
	runId = runId + 1
	local my = runId
	local function alive() return running and my == runId end
	task.spawn(function()
		for i = startIdx or 1, #steps do
			if not alive() then break end
			local s = steps[i]
			status(string.format("Step %d/%d  %s", i, #steps, s.type))
			local ok = execStep(s, alive, i)
			if not ok and alive() then status(string.format("Step %d ข้าม (ไม่สำเร็จ)", i)) end
		end
		if my == runId then
			running = false
			UI.playOff()
			status("เล่นจบแล้ว")
		end
	end)
	return true
end

-- ไฟล์มาโคร --------------------------------------------------------------
local function ensureDir()
	if makefolder and isfolder and not isfolder(DIR) then pcall(makefolder, DIR) end
end
local function cleanName(n)
	n = tostring(n or ""):gsub("[^%w_%-%s]", ""):gsub("^%s+", ""):gsub("%s+$", "")
	return n
end
local function filePath(n) return DIR .. "/" .. n .. ".json" end
local function listMacros()
	local out = {}
	if listfiles then
		local ok, files = pcall(listfiles, DIR)
		if ok then
			for _, f in ipairs(files) do
				local n = tostring(f):match("([^/\\]+)%.json$")
				if n then out[#out + 1] = n end
			end
		end
	end
	table.sort(out)
	return out
end
local function saveMacro(name)
	name = cleanName(name)
	if name == "" then status("ตั้งชื่อมาโครก่อน") return false end
	if #steps == 0 then status("ไม่มีสเต็ปให้เซฟ") return false end
	if not writefile then status("executor ไม่รองรับ writefile") return false end
	ensureDir()
	writefile(filePath(name), HttpService:JSONEncode(steps))
	CFG.selected = name
	saveCfg()
	status("เซฟ " .. name .. " แล้ว (" .. #steps .. " steps)")
	return true
end
local function loadMacro(name)
	if not (isfile and readfile and isfile(filePath(name))) then status("ไม่พบไฟล์ " .. tostring(name)) return false end
	local ok, t = pcall(function() return HttpService:JSONDecode(readfile(filePath(name))) end)
	if ok and type(t) == "table" then
		steps = t
		CFG.selected = name
		saveCfg()
		UI.refresh()
		status("โหลด " .. name .. " (" .. #steps .. " steps)")
		return true
	end
	status("อ่านไฟล์ไม่ได้")
	return false
end

-- Hook ดักตอนเราวาง/อัพ/ขายเอง -------------------------------------------
local hookOK = false
if hookmetamethod and newcclosure and getnamecallmethod then
	local old
	old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		if recording and getnamecallmethod() == "FireServer" and (self == TowerAdd or self == TowerUpgrade or self == TowerSell) then
			local a = ...
			if typeof(a) == "table" then
				local remote = self
				task.spawn(function()
					local ok, err = pcall(onRecord, remote, a)
					if not ok then warn("[JetHub Camera] record error:", err) end
				end)
			end
		end
		return old(self, ...)
	end))
	hookOK = true
end

