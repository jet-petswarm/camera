local function loadCfg()
	if isfile and readfile and isfile(CFG_FILE) then
		local ok, t = pcall(function() return HttpService:JSONDecode(readfile(CFG_FILE)) end)
		if ok and type(t) == "table" then
			for k, v in pairs(t) do
				if k == "flags" and type(v) == "table" then
					for fk, fv in pairs(v) do CFG.flags[fk] = fv end
				else
					CFG[k] = v
				end
			end
		end
	end
end
local function saveCfg()
	if writefile then
		pcall(function() writefile(CFG_FILE, HttpService:JSONEncode(CFG)) end)
	end
end
