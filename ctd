local function updateLive()
	local m = getMoney()
	moneyLbl.Text = "$ " .. fmt(m)
	if CFG.moneyLocked and CFG.moneySrc then
		mStatus.Text = "LOCKED: " .. shortSrc(CFG.moneySrc) .. "  =  " .. comma(m)
		mStatus.TextColor3 = C.ok
	elseif selCand then
		mStatus.Text = "Selected: " .. shortSrc(selCand.src) .. "  =  " .. comma(m) .. "  (ยังไม่ล็อค)"
		mStatus.TextColor3 = C.warn
	else
		mStatus.Text = "ยังไม่ได้เลือกแหล่งเงิน — ใส่เงินจริง → Scan → เลือก → Lock"
		mStatus.TextColor3 = C.sub
	end
	local real = parseNum(realBox.Text)
	local activeSrc = (CFG.moneyLocked and CFG.moneySrc) or (selCand and selCand.src)
	for c, r in pairs(rowRefs) do
		local v = readSource(c.src)
		r.val.Text = comma(v)
		local lv = matchLevel(v, real)
		r.val.TextColor3 = (lv == 2 and C.ok) or (lv == 1 and C.warn) or C.text
		r.frame.BackgroundColor3 = (activeSrc == c.src) and C.sel or C.row
	end
end

