local UUID = ("%x"):rep(8) .. "%-" .. ("%x"):rep(4) .. "%-" .. ("%x"):rep(4) .. "%-" .. ("%x"):rep(4) .. "%-" .. ("%x"):rep(12)
local function isUUID(s) return type(s) == "string" and s:match("^" .. UUID .. "$") ~= nil end

local function idOf(inst)
	if isUUID(inst.Name) then return inst.Name end
	for _, v in pairs(inst:GetAttributes()) do
		if isUUID(v) then return v end
	end
	for _, c in ipairs(inst:GetChildren()) do
		if c:IsA("ValueBase") and isUUID(c.Value) then return c.Value end
	end
	return nil
end

local function posOf(inst)
	if inst:IsA("Model") then
		local ok, cf = pcall(inst.GetPivot, inst)
		if ok then return cf.Position end
	elseif inst:IsA("BasePart") then
		return inst.Position
	end
	local p = inst:FindFirstChildWhichIsA("BasePart", true)
	return p and p.Position
end

local function towersFolder()
	local g = workspace:FindFirstChild("Game")
	return g and g:FindFirstChild("Towers")
end

local function nearCount(pos, r)
	local f = towersFolder()
	if not f then return nil end
	local c = 0
	for _, t in ipairs(f:GetChildren()) do
		local p = posOf(t)
		if p and (p - pos).Magnitude <= r then c = c + 1 end
	end
	return c
end

local function findTowerById(id)
	local f = towersFolder()
	local pool = f and f:GetChildren() or workspace:GetDescendants()
	for _, t in ipairs(pool) do
		if idOf(t) == id then return t end
	end
	if f then
		for _, t in ipairs(f:GetDescendants()) do
			if idOf(t) == id then return t end
		end
	end
	return nil
end

local function findNearestTower(pos, maxDist)
	local f = towersFolder()
	local pool = f and f:GetChildren() or workspace:GetDescendants()
	local best, bestD, bestId = nil, maxDist, nil
	for _, t in ipairs(pool) do
		local id = idOf(t)
		if id then
			local p = posOf(t)
			if p then
				local d = (p - pos).Magnitude
				if d <= bestD then best, bestD, bestId = t, d, id end
			end
		end
	end
	return bestId, best
end

local function unitIdFor(step)
	for i = 1, 5 do
		local n = LP:GetAttribute("Slot" .. i)
		local id = LP:GetAttribute("Slot" .. i .. "Id")
		if n == step.name and type(id) == "string" and id ~= "" then return id end
	end
	return step.unitId
end

--------------------------------------------------------------------------
-- Macro data : steps + ราคาตาม (ยูนิต, ขั้น)
--------------------------------------------------------------------------
local steps = {}
local prices = {}   -- prices[unit][tostring(stage)] = {price=, locked=}
local meta = {}     -- meta[i] = {unit=, stage=}
local recording, running = false, false
local runId, lastT = 0, 0
local curIdx, phase = 0, "act"
local UI = { refresh = function() end, playOff = function() end }
local autoSave = function() end -- ถูกกำหนดจริงทีหลัง (เซฟมาโคร+ราคาอัตโนมัติ)

local function recompute()
	meta = {}
	local counts = {}
	for i, s in ipairs(steps) do
		if s.type == "add" then
			meta[i] = { unit = s.name or "?", stage = 1, tower = i }
			counts[i] = 1
		else
			local best, bd
			if s.tpos then
				local tp = Vector3.new(unpack(s.tpos))
				for j = i - 1, 1, -1 do
					local o = steps[j]
					if o.type == "add" and o.pos then
						local d = (Vector3.new(unpack(o.pos)) - tp).Magnitude
						if d <= 6 and (not bd or d < bd) then best, bd = j, d end
					end
				end
			end
			if best then
				if s.type == "upgrade" then counts[best] = counts[best] + 1 end
				meta[i] = { unit = steps[best].name or "?", stage = counts[best], tower = best }
			else
				meta[i] = { unit = "?", stage = 2, tower = 0 }
			end
		end
	end
end

local function pslot(unit, stage, create)
	local u = prices[unit]
	if not u then
		if not create then return nil end
		u = {}
		prices[unit] = u
	end
	local k = tostring(stage)
	local p = u[k]
	if not p and create then
		p = { price = 0, locked = false }
		u[k] = p
	end
	return p
end

local function priceOf(i)
	local m, s = meta[i], steps[i]
	if not m or not s or s.type == "sell" then return 0 end
	local p = pslot(m.unit, m.stage)
	return p and p.price or 0
end

local function setLearned(i, v)
	local m = meta[i]
	if not m then return end
	local p = pslot(m.unit, m.stage, true)
	if not (CFG.priceLockAll or p.locked) then p.price = v end
end

local function describe(i)
	local s = steps[i]
	if not s then return "?" end
	local m = meta[i] or { unit = "?", stage = 1 }
	if s.type == "add" then return T("d_place", m.unit, math.floor(m.stage))
	elseif s.type == "upgrade" then return T("d_up", m.unit, math.floor(m.stage))
	else return T("d_sell", m.unit) end
end

local function measureDrop(before, timeout)
	local drop, t = 0, os.clock()
	while os.clock() - t < timeout do
		task.wait(0.1)
		local m = getMoney()
		if m then drop = math.max(drop, before - m) end
	end
	return drop
end

