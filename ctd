-- ตัวเลือกแบบเลื่อนแถบ (segmented control)
local function seg(parent, items, props, onPick)
	local n = #items
	local f = new("Frame", { BackgroundColor3 = C.panel, BorderSizePixel = 0 }, parent)
	corner(f, 10)
	apply(f, props)
	local pill = new("Frame", { Size = UDim2.new(1 / n, -6, 1, -6), Position = UDim2.new(0, 3, 0, 3), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 1 }, f)
	corner(pill, 8)
	accGrad(pill, 0)
	local btns, obj = {}, {}
	for i, it in ipairs(items) do
		local b = new("TextButton", {
			Size = UDim2.new(1 / n, 0, 1, 0), Position = UDim2.new((i - 1) / n, 0, 0, 0), BackgroundTransparency = 1,
			Text = "", Font = FONTB, TextSize = 12, TextColor3 = C.sub, AutoButtonColor = false, ZIndex = 2,
		}, f)
		if it.key then bind(b, "Text", it.key) else b.Text = it.text end
		b.MouseButton1Click:Connect(function() onPick(it.id) end)
		btns[it.id] = b
	end
	function obj.set(id, animate)
		for i, it in ipairs(items) do
			local on = (it.id == id)
			tw(btns[it.id], 0.2, { TextColor3 = on and C.ink or C.sub })
			if on then tw(pill, animate == false and 0 or 0.28, { Position = UDim2.new((i - 1) / n, 3, 0, 3) }, QUINT) end
		end
	end
	return obj
end

