	else
		txtK(row, labelKey, { Size = UDim2.new(1, -(x0 + 68), 1, 0), Position = UDim2.fromOffset(x0, 0), Font = FONTB })
	end
	local track = new("TextButton", {
		Text = "", Size = UDim2.fromOffset(44, 24), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		BackgroundColor3 = C.line, BorderSizePixel = 0, AutoButtonColor = false,
	}, row)
	corner(track, 12)
	local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0 }, track)
	corner(fill, 12)
	accGrad(fill, 0)
	local knob = new("Frame", { Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, track)
	corner(knob, 9)
	local state = false
	local function visual(v, animate)
		local d = animate and 0.22 or 0
		if animate then
			tw(knob, 0.09, { Size = UDim2.fromOffset(26, 18), Position = UDim2.fromOffset(v and 15 or 3, 3) })
			task.delay(0.09, function()
				tw(knob, 0.2, { Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(v and 23 or 3, 3) }, BACK)
			end)
		else
			knob.Size = UDim2.fromOffset(18, 18)
			knob.Position = UDim2.fromOffset(v and 23 or 3, 3)
		end
		tw(fill, d, { BackgroundTransparency = v and 0 or 1 })
		tw(rs, d, { Transparency = v and 0.55 or 1 })
	end
	local function set(v, silent)
		state = v and true or false
		visual(state, not silent)
		if not silent and cb then cb(state) end
	end
	track.MouseButton1Click:Connect(function() set(not state) end)
	row.MouseEnter:Connect(function() tw(row, 0.12, { BackgroundColor3 = C.card2:Lerp(Color3.new(1, 1, 1), 0.05) }) end)
	row.MouseLeave:Connect(function() tw(row, 0.15, { BackgroundColor3 = C.card2 }) end)
	state = init and true or false
	visual(state, false)
	return set, row
