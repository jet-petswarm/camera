--------------------------------------------------------------------------
-- Number helpers
--------------------------------------------------------------------------
local SUF = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24, oc = 1e27, no = 1e30, dc = 1e33 }
local FMT = { {1e33,"dc"},{1e30,"no"},{1e27,"oc"},{1e24,"sp"},{1e21,"sx"},{1e18,"qi"},{1e15,"qa"},{1e12,"t"},{1e9,"b"},{1e6,"m"},{1e3,"k"} }

local function parseNum(v)
	if type(v) == "number" then return v end
	if type(v) ~= "string" then return nil end
	local s = (v:lower():gsub("[%$,]", ""))
	local n, suf = s:match("^[^%d%.]*(%d+%.?%d*)%s*(%a*)%s*$")
	n = tonumber(n)
	if not n then return nil end
	if suf and suf ~= "" and SUF[suf] then n = n * SUF[suf] end
	return n
end

local function fmt(n)
	if not n then return "--" end
	for _, f in ipairs(FMT) do
		if math.abs(n) >= f[1] then return string.format("%.2f%s", n / f[1], f[2]) end
	end
	return string.format("%.0f", n)
end

local function comma(n)
	if not n then return "--" end
	local s = string.format("%.0f", n)
	local r = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if r:sub(1, 1) == "," then r = r:sub(2) end
	return r
end

--------------------------------------------------------------------------
-- Instance path helpers (เก็บเป็นรายชื่อจาก game เพื่อเซฟลง JSON ได้)
--------------------------------------------------------------------------
local function pathOf(inst)
	local t, c = {}, inst
	while c and c ~= game do
		table.insert(t, 1, c.Name)
		c = c.Parent
	end
	return t
end

local function resolve(path)
	local c = game
	for _, n in ipairs(path) do
		c = c and c:FindFirstChild(n)
		if not c then return nil end
	end
	return c
end

local instCache = setmetatable({}, { __mode = "k" })
local function resolveCached(src)
	local c = instCache[src]
	if c and c.Parent then return c end
	c = resolve(src.path)
	instCache[src] = c
	return c
end

local function readInst(kind, inst, attr)
	if kind == "val" then return parseNum(inst.Value)
	elseif kind == "attr" then return parseNum(inst:GetAttribute(attr))
	else return parseNum(inst.Text) end
end

local function readSource(src)
	if not src or not src.path then return nil end
	local inst = resolveCached(src)
	if not inst then return nil end
	local ok, v = pcall(readInst, src.kind, inst, src.attr)
	if ok then return v end
	return nil
end

local function shortSrc(src)
	local p, parts = src.path, {}
	for i = math.max(1, #p - 2), #p do parts[#parts + 1] = p[i] end
	local s = table.concat(parts, ".")
	if src.attr then s = s .. "@" .. src.attr end
	return s
end

--------------------------------------------------------------------------
-- Money source
--------------------------------------------------------------------------
local selCand = nil -- candidate ที่เลือกอยู่ (ยังไม่ล็อค)

local function getMoney()
	local src
	if CFG.moneyLocked and CFG.moneySrc then
		src = CFG.moneySrc
	elseif selCand then
		src = selCand.src
	end
	if src then return readSource(src) end
	local ls = LP:FindFirstChild("leaderstats")
	if ls then
		for _, n in ipairs({ "Money", "Cash", "Coins", "Gold" }) do
			local v = ls:FindFirstChild(n)
			if v and v:IsA("ValueBase") then return parseNum(v.Value) end
		end
	end
	return nil
end

local function scanMoney(realVal, filter)
	local cands = {}
	local function push(kind, inst, attr, value)
		if #cands >= 800 then return end
		cands[#cands + 1] = { src = { kind = kind, path = pathOf(inst), attr = attr }, value = value }
	end
	local function visit(inst)
		if inst:IsA("ValueBase") then
			local ok, v = pcall(function() return inst.Value end)
			if ok then
				local n = parseNum(v)
				if n then push("val", inst, nil, n) end
			end
		elseif inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
			local t = inst.Text
			if t ~= "" and t:find("%d") then
				local n = parseNum(t)
				if n then push("text", inst, nil, n) end
			end
		end
		for k, v in pairs(inst:GetAttributes()) do
			if type(v) == "number" then push("attr", inst, k, v) end
		end
	end
	visit(LP)
	for _, d in ipairs(LP:GetDescendants()) do visit(d) end

	local function level(v)
		if not realVal then return 0 end
		local d = math.abs(v - realVal)
		if d <= 0.5 then return 2 end
		if d <= math.max(1, realVal * 0.02) then return 1 end
		return 0
	end
	local KEYS = { "money", "cash", "coin", "gold", "gem", "buck", "currency", "yen" }

	local out = {}
	for _, c in ipairs(cands) do
		local name = (table.concat(c.src.path, ".") .. (c.src.attr or "")):lower()
		if filter == "" or name:find(filter, 1, true) then
			local score = 2 - level(c.value)
			for _, k in ipairs(KEYS) do
				if name:find(k, 1, true) then score = score - 0.5 break end
			end
			c.score = score
			out[#out + 1] = c
		end
	end
	table.sort(out, function(a, b) return a.score < b.score end)
	return out
end

