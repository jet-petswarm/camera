local function T(k, ...)
	local s = (LANG[CFG.lang] and LANG[CFG.lang][k]) or LANG.en[k] or k
	if select("#", ...) > 0 then
		local ok, r = pcall(string.format, s, ...)
		if ok then return r end
	end
	return s
end

local BIND = {}
local function bind(obj, prop, key, ...)
	obj[prop] = T(key, ...)
	BIND[#BIND + 1] = { obj = obj, prop = prop, key = key, args = { ... } }
end
local lastStatus = { "ready" }
local statusLbl
local function status(k, ...)
	lastStatus = { k, ... }
	if statusLbl then statusLbl.Text = T(k, ...) end
end
local function relang()
	for i = #BIND, 1, -1 do
		local b = BIND[i]
		if b.obj.Parent then b.obj[b.prop] = T(b.key, unpack(b.args)) else table.remove(BIND, i) end
	end
	if statusLbl then statusLbl.Text = T(unpack(lastStatus)) end
end

--------------------------------------------------------------------------
-- Number helpers
--------------------------------------------------------------------------
local SUF = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24, oc = 1e27, no = 1e30, dc = 1e33 }
local FMT = { {1e33,"dc"},{1e30,"no"},{1e27,"oc"},{1e24,"sp"},{1e21,"sx"},{1e18,"qi"},{1e15,"qa"},{1e12,"t"},{1e9,"b"},{1e6,"m"},{1e3,"k"} }

local function parseNum(v)
	if type(v) == "number" then return v end
	if type(v) ~= "string" then return nil end
	local s = (v:lower():gsub("[%$,]", ""))
	local n, suf = s:match("^[^%d%.]*(%d+%.?%d*)%s*(%a*)%s*$")
	n = tonumber(n)
	if not n then return nil end
	if suf and suf ~= "" and SUF[suf] then n = n * SUF[suf] end
	return n
end

local function fmt(n)
	if not n then return "--" end
	for _, f in ipairs(FMT) do
		if math.abs(n) >= f[1] then return string.format("%.2f%s", n / f[1], f[2]) end
	end
	return string.format("%.0f", n)
end

