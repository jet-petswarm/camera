local cardState = ""
local function updateCard()
	local n = #steps
	local stText, stCol = T("st_idle"), C.sub
	local l1, l2, l3, frac = "", "", "", 0
	if recording then
		stText, stCol = T("st_rec"), C.bad
		l1 = T("rec_progress", n)
		if n > 0 then l2 = string.format("#%d  %s", n, describe(n)) end
	else
		if running then
			if phase == "match" then stText, stCol = T("st_wait_match"), C.warn
			elseif phase == "money" then stText, stCol = T("st_wait_money"), C.warn
			elseif phase == "loop" then stText, stCol = T("st_loop"), C.acc
			else stText, stCol = T("st_acting"), C.ok end
		end
		if n == 0 then
			l1 = T("no_steps")
		elseif running and phase == "loop" then
			l1 = T("loop_wait")
			frac = 1
		elseif curIdx > n then
			l1 = T("finished")
			frac = 1
		else
			local i = math.max(curIdx, 1)
			l1 = T("next_line", i, n, describe(i))
			local price = priceOf(i)
			if price > 0 then
				local m = getMoney()
				if m then
					if m >= price then l2 = T("money_ok", fmt(m), fmt(price))
					else l2 = T("money_short", fmt(price), fmt(m), fmt(price - m)) end
				else
					l2 = T("money_na")
				end
			else
				l2 = T("money_free")
			end
			if i < n then l3 = T("then_line", describe(i + 1)) end
			frac = (i - 1) / n
		end
	end
	cStateLbl.Text = stText
	cStateLbl.TextColor3 = stCol
	tw(dot, 0.2, { BackgroundColor3 = stCol })
	cCountLbl.Text = (n > 0 and not recording) and (math.min(math.max(curIdx, 1), n) .. " / " .. n) or ""
	cL1.Text, cL2.Text, cL3.Text = l1, l2, l3
	tw(barFill, 0.3, { Size = UDim2.new(math.clamp(frac, 0, 1), 0, 1, 0) })
	if cardState ~= stText then
		cardState = stText
		cardStroke.Transparency = 0.1
		tw(cardStroke, 0.6, { Transparency = 0.6 })
	end
	-- ไฮไลท์สเต็ปที่กำลังทำในแท็บ Steps
	for i, r in pairs(stepRows) do
		if r.Parent then
			local on = running and i == curIdx
			local target = on and C.sel or C.row
			if r.BackgroundColor3 ~= target then tw(r, 0.2, { BackgroundColor3 = target }) end
		end
	end
end

