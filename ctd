local function matchLevel(v, real)
	if not v or not real then return 0 end
	local d = math.abs(v - real)
	if d <= 0.5 then return 2 end
	if d <= math.max(1, real * 0.02) then return 1 end
	return 0
end

local TAG = { val = "V", attr = "A", text = "T" }

local function clearRows()
	for _, r in pairs(rowRefs) do r.frame:Destroy() end
	rowRefs = {}
end

local function doScan()
	clearRows()
	local real = parseNum(realBox.Text)
	local list = scanMoney(real, filtBox.Text:lower())
	local shown = 0
	for _, c in ipairs(list) do
		if shown >= 150 then break end
		shown = shown + 1
		local f = new("Frame", { Size = UDim2.new(1, -6, 0, 26), BackgroundColor3 = C.row, BorderSizePixel = 0 }, listFrame)
		corner(f, 6)
		txt(f, "[" .. TAG[c.src.kind] .. "] " .. shortSrc(c.src), { Size = UDim2.new(1, -130, 1, 0), Position = UDim2.fromOffset(6, 0), TextSize = 12 })
		local v = txt(f, comma(c.value), { Size = UDim2.fromOffset(120, 26), Position = UDim2.new(1, -124, 0, 0), TextXAlignment = Enum.TextXAlignment.Right, TextSize = 12, Font = Enum.Font.GothamBold })
		local click = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, f)
		click.MouseButton1Click:Connect(function()
			if CFG.moneyLocked then status("ต้อง Unlock ก่อนถึงจะเปลี่ยนแหล่งเงินได้") return end
			selCand = c
			status("เลือก " .. shortSrc(c.src) .. " (กด Lock source เพื่อล็อค)")
		end)
		rowRefs[c] = { frame = f, val = v }
	end
	status(string.format("Scan เจอ %d รายการ (แสดง %d) — เขียวคือค่าตรงกับเงินจริง", #list, shown))
	return list
end

bScan.MouseButton1Click:Connect(doScan)

bAuto.MouseButton1Click:Connect(function()
	if CFG.moneyLocked then status("ต้อง Unlock ก่อน") return end
	local real = parseNum(realBox.Text)
	if not real then status("ใส่เงินจริงในเกมก่อน แล้วกด Auto pick") return end
	local list = doScan()
	local best, bestRank
	for _, c in ipairs(list) do
		local lv = matchLevel(c.value, real)
		if lv > 0 then
			local rank = (3 - lv) * 10 + ((c.src.kind == "text") and 5 or 0)
			if not bestRank or rank < bestRank then best, bestRank = c, rank end
		end
	end
	if best then
		selCand = best
		status("Auto pick: " .. shortSrc(best.src))
	else
		status("ไม่พบค่าที่ตรงกับเงินจริง (ลองเปลี่ยนเงินแล้ว Scan ใหม่)")
	end
end)

