local function netFolder(className)
	local ml = RS:FindFirstChild("ModuleLoader")
	local sh = ml and ml:FindFirstChild("Shared")
	local nw = sh and sh:FindFirstChild("Network")
	return nw and nw:FindFirstChild(className)
end
local function fireEvent(name, ...)
	local f = netFolder("RemoteEvent")
	local r = f and f:FindFirstChild(name)
	if r then pcall(r.FireServer, r, ...) return true end
	return false
end
local function invokeFunc(name, ...)
	local f = netFolder("RemoteFunction")
	local r = f and f:FindFirstChild(name)
	if r then
		local args = { ... }
		task.spawn(function() pcall(function() return r:InvokeServer(unpack(args)) end) end)
		return true
	end
	return false
end

local TowerAdd, TowerUpgrade, TowerSell
local upEvt = {}

task.spawn(function()
	while not (TowerAdd and TowerUpgrade and TowerSell) do
		local re = netFolder("RemoteEvent")
		if re then
			TowerAdd = re:FindFirstChild("TowerAdd")
			TowerUpgrade = re:FindFirstChild("TowerUpgrade")
			TowerSell = re:FindFirstChild("TowerSell")
		end
		if not (TowerAdd and TowerUpgrade and TowerSell) then task.wait(2) end
	end
	TowerUpgrade.OnClientEvent:Connect(function(d)
		if type(d) == "table" and d.Id then upEvt[d.Id] = { t = os.clock(), level = d.Level } end
	end)
end)

